<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:SampleEcommerceMobileUI.ViewModels"
    x:Class="SampleEcommerceMobileUI.Views.User.OrdersHistoryPage"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{StaticResource BackgroundLight}">

    <Grid RowDefinitions="Auto, *" Padding="20,16">

        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto, *" Margin="0,24,0,16">
            <Label Grid.Column="0" Text="←" FontSize="28" TextColor="{StaticResource TextPrimary}">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding GoBackCommand}" />
                </Label.GestureRecognizers>
            </Label>
            <Label Grid.Column="1" Text="My Orders" Style="{StaticResource HeadingSmall}" VerticalOptions="Center" Margin="16,0,0,0" />
        </Grid>

        <!-- Orders List -->
        <CollectionView Grid.Row="1" ItemsSource="{Binding Orders}">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="12" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Style="{StaticResource CardFrame}" Padding="16">
                        <VerticalStackLayout Spacing="12">
                            <!-- Order Header -->
                            <Grid ColumnDefinitions="*, Auto">
                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                    <Label Text="{Binding OrderId}" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                                    <Label Text="{Binding FormattedDate}" FontSize="12" TextColor="{StaticResource TextLight}" />
                                </VerticalStackLayout>
                                <Frame
                                    Grid.Column="1"
                                    BackgroundColor="{Binding StatusColor}"
                                    CornerRadius="10"
                                    Padding="10,4"
                                    HasShadow="False"
                                    VerticalOptions="Start">
                                    <Label Text="{Binding Status}" FontSize="11" TextColor="White" FontAttributes="Bold" />
                                </Frame>
                            </Grid>

                            <BoxView HeightRequest="1" Color="{StaticResource Border}" />

                            <!-- Order Items Count -->
                            <Grid ColumnDefinitions="*, Auto">
                                <Label
                                    Grid.Column="0"
                                    Text="{Binding Items.Count, StringFormat='{0} item(s)'}"
                                    Style="{StaticResource BodyMedium}" />
                                <Label
                                    Grid.Column="1"
                                    Text="{Binding FormattedTotal}"
                                    FontSize="16"
                                    FontAttributes="Bold"
                                    TextColor="{StaticResource Accent}" />
                            </Grid>

                            <!-- Payment Info -->
                            <Label
                                Text="{Binding PaymentMethod, StringFormat='Paid via {0}'}"
                                FontSize="12"
                                TextColor="{StaticResource TextLight}" />
                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            <CollectionView.EmptyView>
                <VerticalStackLayout
                    VerticalOptions="Center"
                    HorizontalOptions="Center"
                    Spacing="16"
                    Padding="40">
                    <Label Text="📦" FontSize="60" HorizontalOptions="Center" />
                    <Label Text="No orders yet" Style="{StaticResource HeadingSmall}" HorizontalTextAlignment="Center" />
                    <Label Text="Your order history will appear here." Style="{StaticResource BodyMedium}" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
        </CollectionView>
    </Grid>
</ContentPage>
