<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:SampleEcommerceMobileUI.ViewModels"
    x:Class="SampleEcommerceMobileUI.Views.Authentication.LoginPage"
    Shell.NavBarIsVisible="False"
    Shell.TabBarIsVisible="False"
    BackgroundColor="{StaticResource BackgroundWhite}">

    <ContentPage.BindingContext>
        <vm:LoginViewModel />
    </ContentPage.BindingContext>

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="20">

            <!-- Back Button -->
            <Label
                Text="←"
                FontSize="28"
                TextColor="{StaticResource TextPrimary}"
                Margin="0,20,0,0">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding GoBackCommand}" />
                </Label.GestureRecognizers>
            </Label>

            <!-- Header -->
            <VerticalStackLayout Spacing="8" Margin="0,20,0,0">
                <Label
                    Text="Welcome Back 👋"
                    Style="{StaticResource HeadingLarge}" />
                <Label
                    Text="Sign in to continue shopping"
                    Style="{StaticResource BodyMedium}" />
            </VerticalStackLayout>

            <!-- Email Input -->
            <VerticalStackLayout Spacing="8">
                <Label Text="Email" Style="{StaticResource BodyMedium}" TextColor="{StaticResource TextPrimary}" />
                <Frame Style="{StaticResource CardFrameSmall}" Padding="4,0" HasShadow="False" BackgroundColor="{StaticResource SurfaceVariant}">
                    <Entry
                        Placeholder="Enter your email"
                        Text="{Binding Email}"
                        Keyboard="Email"
                        Style="{StaticResource StandardEntry}" />
                </Frame>
            </VerticalStackLayout>

            <!-- Password Input -->
            <VerticalStackLayout Spacing="8">
                <Label Text="Password" Style="{StaticResource BodyMedium}" TextColor="{StaticResource TextPrimary}" />
                <Frame Style="{StaticResource CardFrameSmall}" Padding="4,0" HasShadow="False" BackgroundColor="{StaticResource SurfaceVariant}">
                    <Entry
                        Placeholder="Enter your password"
                        Text="{Binding Password}"
                        IsPassword="True"
                        Style="{StaticResource StandardEntry}" />
                </Frame>
            </VerticalStackLayout>

            <!-- Forgot Password -->
            <Label
                Text="Forgot Password?"
                Style="{StaticResource BodyMedium}"
                TextColor="{StaticResource Accent}"
                HorizontalOptions="End">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ForgotPasswordCommand}" />
                </Label.GestureRecognizers>
            </Label>

            <!-- Login Button -->
            <Button
                Text="Sign In"
                Style="{StaticResource PrimaryButton}"
                Command="{Binding LoginCommand}"
                Margin="0,10,0,0" />

            <!-- Divider -->
            <Grid ColumnDefinitions="*, Auto, *" Margin="0,10">
                <BoxView Grid.Column="0" HeightRequest="1" Color="{StaticResource Border}" VerticalOptions="Center" />
                <Label Grid.Column="1" Text="  or continue with  " Style="{StaticResource BodySmall}" VerticalOptions="Center" />
                <BoxView Grid.Column="2" HeightRequest="1" Color="{StaticResource Border}" VerticalOptions="Center" />
            </Grid>

            <!-- Social Login -->
            <HorizontalStackLayout HorizontalOptions="Center" Spacing="16">
                <Frame
                    Style="{StaticResource CardFrameSmall}"
                    WidthRequest="80"
                    HeightRequest="56"
                    Padding="0">
                    <Label Text="G" FontSize="24" FontAttributes="Bold" TextColor="#DB4437"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SocialLoginCommand}" CommandParameter="Google" />
                    </Frame.GestureRecognizers>
                </Frame>
                <Frame
                    Style="{StaticResource CardFrameSmall}"
                    WidthRequest="80"
                    HeightRequest="56"
                    Padding="0">
                    <Label Text="f" FontSize="24" FontAttributes="Bold" TextColor="#1877F2"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SocialLoginCommand}" CommandParameter="Facebook" />
                    </Frame.GestureRecognizers>
                </Frame>
            </HorizontalStackLayout>

            <!-- Register Link -->
            <HorizontalStackLayout HorizontalOptions="Center" Spacing="4" Margin="0,20,0,40">
                <Label Text="Don't have an account?" Style="{StaticResource BodyMedium}" />
                <Label
                    Text="Sign Up"
                    Style="{StaticResource BodyMedium}"
                    TextColor="{StaticResource Accent}"
                    FontAttributes="Bold">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NavigateToRegisterCommand}" />
                    </Label.GestureRecognizers>
                </Label>
            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
