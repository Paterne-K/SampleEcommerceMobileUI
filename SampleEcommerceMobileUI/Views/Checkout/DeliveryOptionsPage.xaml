<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:SampleEcommerceMobileUI.ViewModels"
    x:Class="SampleEcommerceMobileUI.Views.Checkout.DeliveryOptionsPage"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{StaticResource BackgroundLight}">

    <Grid RowDefinitions="Auto, *, Auto" Padding="20,16">

        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto, *" Margin="0,24,0,16">
            <Label Grid.Column="0" Text="←" FontSize="28" TextColor="{StaticResource TextPrimary}">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding GoBackCommand}" />
                </Label.GestureRecognizers>
            </Label>
            <Label Grid.Column="1" Text="Delivery Options" Style="{StaticResource HeadingSmall}" VerticalOptions="Center" Margin="16,0,0,0" />
        </Grid>

        <!-- Delivery Options List -->
        <CollectionView Grid.Row="1" ItemsSource="{Binding DeliveryOptions}">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="12" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Style="{StaticResource CardFrame}" Padding="16">
                        <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="16">
                            <!-- Icon -->
                            <Frame
                                Grid.Column="0"
                                BackgroundColor="{StaticResource SurfaceVariant}"
                                CornerRadius="16"
                                HeightRequest="48"
                                WidthRequest="48"
                                Padding="0"
                                HasShadow="False">
                                <Label Text="{Binding Icon}" FontSize="22" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Frame>
                            <!-- Details -->
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                <Label Text="{Binding Name}" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                                <Label Text="{Binding EstimatedDays}" FontSize="12" TextColor="{StaticResource TextLight}" />
                            </VerticalStackLayout>
                            <!-- Price -->
                            <Label
                                Grid.Column="2"
                                Text="{Binding FormattedPrice}"
                                FontSize="14"
                                FontAttributes="Bold"
                                TextColor="{StaticResource Accent}"
                                VerticalOptions="Center" />
                        </Grid>
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DeliveryOptionsViewModel}}, Path=SelectOptionCommand}"
                                CommandParameter="{Binding .}" />
                        </Frame.GestureRecognizers>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Continue Button -->
        <Button
            Grid.Row="2"
            Text="Continue"
            Style="{StaticResource PrimaryButton}"
            Command="{Binding ContinueCommand}"
            Margin="0,12,0,20" />
    </Grid>
</ContentPage>
