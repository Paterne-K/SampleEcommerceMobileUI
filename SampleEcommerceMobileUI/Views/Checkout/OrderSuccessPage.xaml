<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="SampleEcommerceMobileUI.Views.Checkout.OrderSuccessPage"
    Shell.NavBarIsVisible="False"
    Shell.TabBarIsVisible="False"
    BackgroundColor="{StaticResource BackgroundWhite}">

    <VerticalStackLayout
        VerticalOptions="Center"
        HorizontalOptions="Center"
        Spacing="20"
        Padding="40">

        <!-- Success Icon -->
        <Frame
            BackgroundColor="{StaticResource Success}"
            CornerRadius="50"
            HeightRequest="100"
            WidthRequest="100"
            Padding="0"
            HasShadow="False"
            HorizontalOptions="Center">
            <Label
                Text="✓"
                FontSize="48"
                FontAttributes="Bold"
                TextColor="White"
                HorizontalOptions="Center"
                VerticalOptions="Center" />
        </Frame>

        <!-- Success Message -->
        <Label
            Text="Order Placed! 🎉"
            Style="{StaticResource HeadingLarge}"
            HorizontalTextAlignment="Center" />

        <Label
            Text="Your order has been placed successfully. You will receive a confirmation SMS shortly."
            Style="{StaticResource BodyMedium}"
            HorizontalTextAlignment="Center"
            Margin="20,0" />

        <Label
            Text="Order ID: CAM-2025-004"
            FontSize="14"
            FontAttributes="Bold"
            TextColor="{StaticResource TextPrimary}"
            HorizontalTextAlignment="Center" />

        <!-- Delivery Info -->
        <Frame
            BackgroundColor="{StaticResource SurfaceVariant}"
            CornerRadius="16"
            Padding="20"
            HasShadow="False"
            HorizontalOptions="Fill"
            Margin="0,10">
            <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                <Label Text="🚚 Estimated Delivery" FontSize="13" TextColor="{StaticResource TextLight}" HorizontalTextAlignment="Center" />
                <Label Text="3-5 Business Days" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
        </Frame>

        <!-- Actions -->
        <Button
            Text="Continue Shopping"
            Style="{StaticResource PrimaryButton}"
            Clicked="OnContinueShoppingClicked"
            Margin="0,10,0,0" />

        <Button
            Text="View My Orders"
            Style="{StaticResource OutlineButton}"
            Clicked="OnViewOrdersClicked" />

    </VerticalStackLayout>
</ContentPage>
