<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:SampleEcommerceMobileUI.ViewModels"
    x:Class="SampleEcommerceMobileUI.Views.Checkout.OrderSummaryPage"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{StaticResource BackgroundLight}">

    <Grid RowDefinitions="Auto, *, Auto" Padding="20,16">

        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto, *" Margin="0,24,0,16">
            <Label Grid.Column="0" Text="←" FontSize="28" TextColor="{StaticResource TextPrimary}">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding GoBackCommand}" />
                </Label.GestureRecognizers>
            </Label>
            <Label Grid.Column="1" Text="Order Summary" Style="{StaticResource HeadingSmall}" VerticalOptions="Center" Margin="16,0,0,0" />
        </Grid>

        <!-- Summary Content -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="16">

                <!-- Shipping Address Card -->
                <Frame Style="{StaticResource CardFrame}" Padding="16">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="📍 Shipping Address" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                        <Label Text="{Binding ShippingAddress}" Style="{StaticResource BodyMedium}" />
                    </VerticalStackLayout>
                </Frame>

                <!-- Delivery Method Card -->
                <Frame Style="{StaticResource CardFrame}" Padding="16">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="🚚 Delivery Method" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                        <Label Text="{Binding DeliveryMethod}" Style="{StaticResource BodyMedium}" />
                    </VerticalStackLayout>
                </Frame>

                <!-- Payment Method Card -->
                <Frame Style="{StaticResource CardFrame}" Padding="16">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="💳 Payment Method" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                        <Label Text="{Binding PaymentMethod}" Style="{StaticResource BodyMedium}" />
                    </VerticalStackLayout>
                </Frame>

                <!-- Order Totals Card -->
                <Frame Style="{StaticResource CardFrame}" Padding="16">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Order Details" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Grid.Column="0" Text="Subtotal" Style="{StaticResource BodyMedium}" />
                            <Label Grid.Column="1" Text="{Binding FormattedSubtotal}" FontSize="14" TextColor="{StaticResource TextPrimary}" />
                        </Grid>
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Grid.Column="0" Text="Delivery" Style="{StaticResource BodyMedium}" />
                            <Label Grid.Column="1" Text="{Binding FormattedDelivery}" FontSize="14" TextColor="{StaticResource TextSecondary}" />
                        </Grid>
                        <BoxView HeightRequest="1" Color="{StaticResource Border}" />
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Grid.Column="0" Text="Total" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                            <Label Grid.Column="1" Text="{Binding FormattedTotal}" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource Accent}" />
                        </Grid>
                    </VerticalStackLayout>
                </Frame>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Place Order Button -->
        <VerticalStackLayout Grid.Row="2" Spacing="8" Margin="0,12,0,20">
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
            <Button
                Text="Place Order"
                Style="{StaticResource AccentButton}"
                Command="{Binding PlaceOrderCommand}" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
