<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:SampleEcommerceMobileUI.ViewModels"
    x:Class="SampleEcommerceMobileUI.Views.Main.ProductDetailsPage"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{StaticResource BackgroundLight}">

    <Grid RowDefinitions="*, Auto">
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Spacing="0">

                <!-- Product Image Area -->
                <Grid HeightRequest="350">
                    <Frame
                        BackgroundColor="{StaticResource SurfaceVariant}"
                        CornerRadius="0"
                        HasShadow="False"
                        Padding="0">
                        <Label
                            Text="🛍️"
                            FontSize="80"
                            HorizontalOptions="Center"
                            VerticalOptions="Center"
                            TextColor="{StaticResource TextLight}" />
                    </Frame>
                    <!-- Back and Favorite buttons -->
                    <Grid
                        ColumnDefinitions="Auto, *, Auto"
                        Padding="20,50,20,0"
                        VerticalOptions="Start">
                        <Frame
                            Grid.Column="0"
                            BackgroundColor="{StaticResource BackgroundWhite}"
                            CornerRadius="20"
                            HeightRequest="40"
                            WidthRequest="40"
                            Padding="0"
                            HasShadow="True">
                            <Label Text="←" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding GoBackCommand}" />
                                </Label.GestureRecognizers>
                            </Label>
                        </Frame>
                        <Frame
                            Grid.Column="2"
                            BackgroundColor="{StaticResource BackgroundWhite}"
                            CornerRadius="20"
                            HeightRequest="40"
                            WidthRequest="40"
                            Padding="0"
                            HasShadow="True">
                            <Label Text="♡" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ToggleFavoriteCommand}" />
                                </Label.GestureRecognizers>
                            </Label>
                        </Frame>
                    </Grid>
                </Grid>

                <!-- Product Details Content -->
                <Frame
                    BackgroundColor="{StaticResource BackgroundWhite}"
                    CornerRadius="28"
                    Margin="0,-28,0,0"
                    Padding="24,28,24,20"
                    HasShadow="False">
                    <VerticalStackLayout Spacing="16">

                        <!-- Name and Rating -->
                        <Grid ColumnDefinitions="*, Auto">
                            <VerticalStackLayout Grid.Column="0" Spacing="4">
                                <Label
                                    Text="{Binding Product.Name}"
                                    Style="{StaticResource HeadingMedium}" />
                                <Label
                                    Text="{Binding Product.Category}"
                                    Style="{StaticResource BodyMedium}" />
                            </VerticalStackLayout>
                            <HorizontalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Start">
                                <Label Text="⭐" FontSize="16" />
                                <Label Text="{Binding Product.Rating}" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                                <Label Text="{Binding Product.ReviewCount, StringFormat='({0})'}" FontSize="12" TextColor="{StaticResource TextLight}" VerticalOptions="End" />
                            </HorizontalStackLayout>
                        </Grid>

                        <!-- Price -->
                        <Label
                            Text="{Binding Product.FormattedPrice}"
                            FontSize="24"
                            FontAttributes="Bold"
                            TextColor="{StaticResource Accent}" />

                        <!-- Description -->
                        <Label Text="Description" Style="{StaticResource HeadingSmall}" FontSize="16" />
                        <Label
                            Text="{Binding Product.Description}"
                            Style="{StaticResource BodyMedium}"
                            LineBreakMode="WordWrap" />

                        <!-- Size Selection -->
                        <Label Text="Size" Style="{StaticResource HeadingSmall}" FontSize="16" />
                        <CollectionView
                            ItemsSource="{Binding Product.Sizes}"
                            HeightRequest="48"
                            ItemsLayout="HorizontalList"
                            SelectionMode="Single">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Frame
                                        BackgroundColor="{StaticResource SurfaceVariant}"
                                        CornerRadius="12"
                                        HeightRequest="40"
                                        WidthRequest="50"
                                        Padding="0"
                                        HasShadow="False"
                                        Margin="0,0,8,0">
                                        <Label
                                            Text="{Binding .}"
                                            FontSize="14"
                                            FontAttributes="Bold"
                                            HorizontalOptions="Center"
                                            VerticalOptions="Center"
                                            TextColor="{StaticResource TextPrimary}" />
                                    </Frame>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                        <!-- Color Selection -->
                        <Label Text="Color" Style="{StaticResource HeadingSmall}" FontSize="16" />
                        <CollectionView
                            ItemsSource="{Binding Product.Colors}"
                            HeightRequest="48"
                            ItemsLayout="HorizontalList"
                            SelectionMode="Single">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Frame
                                        BackgroundColor="{StaticResource SurfaceVariant}"
                                        CornerRadius="12"
                                        HeightRequest="40"
                                        Padding="12,0"
                                        HasShadow="False"
                                        Margin="0,0,8,0">
                                        <Label
                                            Text="{Binding .}"
                                            FontSize="13"
                                            HorizontalOptions="Center"
                                            VerticalOptions="Center"
                                            TextColor="{StaticResource TextPrimary}" />
                                    </Frame>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                        <!-- Quantity -->
                        <Label Text="Quantity" Style="{StaticResource HeadingSmall}" FontSize="16" />
                        <HorizontalStackLayout Spacing="16" VerticalOptions="Center">
                            <Frame
                                BackgroundColor="{StaticResource SurfaceVariant}"
                                CornerRadius="12"
                                HeightRequest="40"
                                WidthRequest="40"
                                Padding="0"
                                HasShadow="False">
                                <Label Text="−" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding DecrementCommand}" />
                                    </Label.GestureRecognizers>
                                </Label>
                            </Frame>
                            <Label
                                Text="{Binding Quantity}"
                                FontSize="18"
                                FontAttributes="Bold"
                                VerticalOptions="Center"
                                WidthRequest="30"
                                HorizontalTextAlignment="Center" />
                            <Frame
                                BackgroundColor="{StaticResource Primary}"
                                CornerRadius="12"
                                HeightRequest="40"
                                WidthRequest="40"
                                Padding="0"
                                HasShadow="False">
                                <Label Text="+" FontSize="20" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding IncrementCommand}" />
                                    </Label.GestureRecognizers>
                                </Label>
                            </Frame>
                        </HorizontalStackLayout>

                    </VerticalStackLayout>
                </Frame>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Bottom Add to Cart Bar -->
        <Frame
            Grid.Row="1"
            BackgroundColor="{StaticResource BackgroundWhite}"
            CornerRadius="0"
            Padding="20,16"
            HasShadow="True"
            BorderColor="Transparent">
            <Grid ColumnDefinitions="*, 2*" ColumnSpacing="16">
                <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                    <Label Text="Total Price" FontSize="12" TextColor="{StaticResource TextLight}" />
                    <Label Text="{Binding Product.FormattedPrice}" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource Accent}" />
                </VerticalStackLayout>
                <Button
                    Grid.Column="1"
                    Text="🛒 Add to Cart"
                    Style="{StaticResource PrimaryButton}"
                    Command="{Binding AddToCartCommand}" />
            </Grid>
        </Frame>
    </Grid>
</ContentPage>
