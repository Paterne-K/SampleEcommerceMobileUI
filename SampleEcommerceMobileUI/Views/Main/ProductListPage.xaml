<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:SampleEcommerceMobileUI.ViewModels"
    x:Class="SampleEcommerceMobileUI.Views.Main.ProductListPage"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{StaticResource BackgroundLight}">

    <Grid RowDefinitions="Auto, *" Padding="20,16">

        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto" Margin="0,24,0,16">
            <Label
                Grid.Column="0"
                Text="←"
                FontSize="28"
                TextColor="{StaticResource TextPrimary}">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding GoBackCommand}" />
                </Label.GestureRecognizers>
            </Label>
            <Label
                Grid.Column="1"
                Text="{Binding Title}"
                Style="{StaticResource HeadingSmall}"
                HorizontalTextAlignment="Center"
                VerticalOptions="Center" />
            <Label
                Grid.Column="2"
                Text="🔍"
                FontSize="22"
                VerticalOptions="Center" />
        </Grid>

        <!-- Product Grid -->
        <CollectionView
            Grid.Row="1"
            ItemsSource="{Binding Products}"
            SelectionMode="Single"
            SelectionChanged="OnProductSelected">
            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical" Span="2" HorizontalItemSpacing="12" VerticalItemSpacing="12" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame
                        Style="{StaticResource CardFrame}"
                        Padding="0">
                        <VerticalStackLayout Spacing="0">
                            <!-- Product Image -->
                            <Frame
                                BackgroundColor="{StaticResource SurfaceVariant}"
                                CornerRadius="16"
                                HeightRequest="150"
                                HasShadow="False"
                                Padding="0"
                                Margin="8,8,8,0">
                                <Grid>
                                    <Label
                                        Text="🛍️"
                                        FontSize="36"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center"
                                        TextColor="{StaticResource TextLight}" />
                                    <Frame
                                        BackgroundColor="{StaticResource BackgroundWhite}"
                                        CornerRadius="14"
                                        HeightRequest="28"
                                        WidthRequest="28"
                                        Padding="0"
                                        HasShadow="False"
                                        HorizontalOptions="End"
                                        VerticalOptions="Start"
                                        Margin="8">
                                        <Label Text="♡" FontSize="14" HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Frame>
                                </Grid>
                            </Frame>
                            <!-- Info -->
                            <VerticalStackLayout Padding="12,8" Spacing="4">
                                <Label
                                    Text="{Binding Name}"
                                    FontSize="14"
                                    FontAttributes="Bold"
                                    TextColor="{StaticResource TextPrimary}"
                                    LineBreakMode="TailTruncation"
                                    MaxLines="1" />
                                <Label
                                    Text="{Binding Category}"
                                    FontSize="11"
                                    TextColor="{StaticResource TextLight}" />
                                <Grid ColumnDefinitions="*, Auto">
                                    <Label
                                        Grid.Column="0"
                                        Text="{Binding FormattedPrice}"
                                        Style="{StaticResource PriceLabel}"
                                        FontSize="13" />
                                    <HorizontalStackLayout Grid.Column="1" Spacing="2">
                                        <Label Text="⭐" FontSize="10" />
                                        <Label Text="{Binding Rating}" FontSize="11" TextColor="{StaticResource TextSecondary}" />
                                    </HorizontalStackLayout>
                                </Grid>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            <CollectionView.EmptyView>
                <VerticalStackLayout
                    VerticalOptions="Center"
                    HorizontalOptions="Center"
                    Spacing="16"
                    Padding="40">
                    <Label Text="📦" FontSize="60" HorizontalOptions="Center" />
                    <Label
                        Text="No products found"
                        Style="{StaticResource HeadingSmall}"
                        HorizontalTextAlignment="Center" />
                    <Label
                        Text="Try a different category or check back later."
                        Style="{StaticResource BodyMedium}"
                        HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
        </CollectionView>
    </Grid>
</ContentPage>
