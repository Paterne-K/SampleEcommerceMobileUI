<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="SampleEcommerceMobileUI.Components.LoadingSkeletonView">

    <VerticalStackLayout Spacing="12" Padding="20">
        <!-- Skeleton Card 1 -->
        <Frame Style="{StaticResource CardFrame}" Padding="12">
            <Grid ColumnDefinitions="80, *" ColumnSpacing="12">
                <BoxView
                    Grid.Column="0"
                    BackgroundColor="{StaticResource SurfaceVariant}"
                    HeightRequest="80"
                    WidthRequest="80"
                    CornerRadius="12" />
                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="8">
                    <BoxView BackgroundColor="{StaticResource SurfaceVariant}" HeightRequest="16" WidthRequest="150" CornerRadius="8" HorizontalOptions="Start" />
                    <BoxView BackgroundColor="{StaticResource SurfaceVariant}" HeightRequest="12" WidthRequest="100" CornerRadius="6" HorizontalOptions="Start" />
                    <BoxView BackgroundColor="{StaticResource SurfaceVariant}" HeightRequest="14" WidthRequest="80" CornerRadius="7" HorizontalOptions="Start" />
                </VerticalStackLayout>
            </Grid>
        </Frame>
        <!-- Skeleton Card 2 -->
        <Frame Style="{StaticResource CardFrame}" Padding="12">
            <Grid ColumnDefinitions="80, *" ColumnSpacing="12">
                <BoxView
                    Grid.Column="0"
                    BackgroundColor="{StaticResource SurfaceVariant}"
                    HeightRequest="80"
                    WidthRequest="80"
                    CornerRadius="12" />
                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="8">
                    <BoxView BackgroundColor="{StaticResource SurfaceVariant}" HeightRequest="16" WidthRequest="130" CornerRadius="8" HorizontalOptions="Start" />
                    <BoxView BackgroundColor="{StaticResource SurfaceVariant}" HeightRequest="12" WidthRequest="90" CornerRadius="6" HorizontalOptions="Start" />
                    <BoxView BackgroundColor="{StaticResource SurfaceVariant}" HeightRequest="14" WidthRequest="70" CornerRadius="7" HorizontalOptions="Start" />
                </VerticalStackLayout>
            </Grid>
        </Frame>
        <!-- Skeleton Card 3 -->
        <Frame Style="{StaticResource CardFrame}" Padding="12">
            <Grid ColumnDefinitions="80, *" ColumnSpacing="12">
                <BoxView
                    Grid.Column="0"
                    BackgroundColor="{StaticResource SurfaceVariant}"
                    HeightRequest="80"
                    WidthRequest="80"
                    CornerRadius="12" />
                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="8">
                    <BoxView BackgroundColor="{StaticResource SurfaceVariant}" HeightRequest="16" WidthRequest="140" CornerRadius="8" HorizontalOptions="Start" />
                    <BoxView BackgroundColor="{StaticResource SurfaceVariant}" HeightRequest="12" WidthRequest="110" CornerRadius="6" HorizontalOptions="Start" />
                    <BoxView BackgroundColor="{StaticResource SurfaceVariant}" HeightRequest="14" WidthRequest="85" CornerRadius="7" HorizontalOptions="Start" />
                </VerticalStackLayout>
            </Grid>
        </Frame>
    </VerticalStackLayout>
</ContentView>
